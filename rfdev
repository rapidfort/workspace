#!/usr/bin/env bash
# rfdev: simple persistent tmux with mouse support
set -euo pipefail
SESSION=$(basename "$0")

CONF="${HOME}/.config/tmux/${SESSION}.conf"
mkdir -p "$(dirname "$CONF")"

# minimal config with working mouse
cat >"$CONF" <<'CFG'
set -g mouse on
set -g default-terminal "tmux-256color"
set -as terminal-overrides ",*:RGB"
unbind C-b
set -g prefix C-o
bind-key C-o send-prefix
set -g status-interval 10
set -g status-right "%a %h-%d %H:%M"
set -g set-titles on
set -g set-titles-string "#S:#W"
CFG

# create or attach
if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux -f "$CONF" attach -t "$SESSION"
else
  tmux -f "$CONF" new-session -d -s "$SESSION" -n cli
  for w in platform common test log build; do
    tmux new-window -t "$SESSION" -n "$w"
  done
  exec tmux -f "$CONF" attach -t "$SESSION"
fi